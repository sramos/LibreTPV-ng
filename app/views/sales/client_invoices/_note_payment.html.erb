<% header = 'Cobrar compra' %>
<% payments = PaymentType.active.order(:name) %>

<%= form_beginning model: [:sales, @note, @invoice], header: header %>
  <%= form_errors @invoice %>
  <div class="formulario_izq">
    <div id="to_be_charged" class="importe_grande">
      <br>A Cobrar<br><%= note.total_amount %> €
    </div>
    <div id="to_be_returned" class="devolver_grande">
      <br>A Devolver<br>
      <div id="to_be_returned_value"></div>
    </div>    
  </div>
  <div class="formulario_dcha">
    <div class="linea">
      <%= fecha 'Fecha de pago', 'invoice', 'date' %>
    </div>
    <div class="linea">
      <%= selector 'Forma de pago', '', 'payment_type_id',
                   payments.map{|c| [c.name,c.id]},
                   {enriquecido: true, valor: payments.find_by(cash: true)&.id, id: 'payment_type_select'} %>
    </div>
    <div class="linea">
      <%= texto 'Recibido (€)', '', 'received', nil, {id: 'received_input'} %>
    </div>
    <div class="linea">
      <%= _checkbox 'Imprimir ticket', '', 'print_ticket', {elemento: 'elemento_x05', izquierda: true, abajo: true} %>
    </div>
  </div>
<%= form_end send_label: 'Cobrar' %>

<script>
  (function(){
    var selectEl = document.getElementById('payment_type_select');
    var inputEl = document.getElementById('received_input');
    var toReturnBox = document.getElementById('to_be_returned');
    var toReturnValueEl = document.getElementById('to_be_returned_value');
    var formEl = inputEl ? inputEl.closest('form') : null;
    var submitEl = formEl ? formEl.querySelector('input[type="submit"], button[type="submit"]') : null;
    if (!selectEl || !inputEl || !toReturnBox || !toReturnValueEl) { return; }

    // Build cash payment type id set from server data
    var cashIds = new Set(<%= raw(payments.select(&:cash).map(&:id).to_json) %>);
    var totalAmount = <%= @note.total_amount.to_f %>;

    function updateReturn(){
      var selectedId = parseInt(selectEl.value, 10);
      var isCash = cashIds.has(selectedId);
      if (!isCash) { toReturnBox.style.display = 'none'; return; }
      var received = parseFloat(inputEl.value.replace(',', '.'));
      if (isNaN(received)) { toReturnBox.style.display = 'none'; return; }
      var diff = (received - totalAmount);
      if (diff > 0) {
        toReturnValueEl.textContent = diff.toFixed(2) + ' €';
        toReturnBox.style.display = 'block';
      } else {
        toReturnBox.style.display = 'none';
      }
      updateSubmit(received);
    }

    function updateSubmit(received){
      if (!submitEl) return;
      var val = (typeof received === 'number') ? received : parseFloat(inputEl.value.replace(',', '.'));
      var enable = !isNaN(val) && val >= totalAmount;
      submitEl.disabled = !enable;
      submitEl.classList.toggle('disabled', !enable);
    }

    selectEl.addEventListener('change', updateReturn);
    inputEl.addEventListener('input', updateReturn);
    // Initial paint
    updateReturn();
    updateSubmit();
  })();
</script>