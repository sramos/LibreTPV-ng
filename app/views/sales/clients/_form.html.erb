<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:sales, @client], header: header %>
  <%= form_errors @client %>
  <div class="linea">
    <%= _text_field 'Nombre', 'client', 'name', '4', required: true %>
    <%= _text_field 'NIF', 'client', 'code_id', '1' %>
    <div class="elemento_derecha">
      <%= _checkbox_field 'Activo', 'client', 'active', '1', {checked: @client.active} %>
    </div>
  </div>
  <div class="linea">
    <%= _text_field '% Descuento', 'client', 'discount_value', '1' %>
    <%= _text_field 'Acumulado', 'client', 'accumulated_credit', '1' %>
    <%= _text_field 'Crédito', 'client', 'credit', '1' %>
    <div class="elemento_derecha">
      <%= _checkbox_field 'Factura completa', 'client', 'is_b2b', '1', {checked: @client.is_b2b} %>
    </div>
  </div>
  <%= render partial: 'sales/clients/form_contact_info' %>
<%= form_end %>