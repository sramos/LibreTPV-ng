<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:sales, @client], header: header %>
  <%= form_errors @client %>
  <%= texto 'Nombre', 'client', 'name' %>
  <%= _checkbox 'Activo', 'client', 'active', {elemento: 'elemento_x05', izquierda: true, abajo: true, checked: @client.active} %>
<%= form_end %>