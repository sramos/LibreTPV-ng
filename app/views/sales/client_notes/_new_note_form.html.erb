<fieldset class="filtrado" id="fieldset_new_client_note">
  <%= form_tag( new_sales_client_note_path, method: :get, multipart: true, class: 'index_form' ) %>
    <div class="fila"></div>
    <div class="linea">
      <%= _date_field 'Fecha', 'note', 'date', class: 'input_filter_field' %>
      <div class="form_field element_1_5">&nbsp;</div>
      <%= _select_field 'Cliente', 'note', 'client_id', Client.active.map{|c| [c.name,c.id]}, '2', enchanced: true, required: true %>
    </div>
    <div class="elemento_derecha" id='boton_filtrado'><br/>
      <%= submit_tag 'Nueva venta', class: 'boton', 'data-disable-with' => 'Filtrando...' %>
    </div>
  </form>
  <br/>
</fieldset>