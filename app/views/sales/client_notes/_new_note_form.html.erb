<fieldset class="filtrado" id="fieldset_new_client_note">
  <%= form_tag( new_sales_client_note_path, multipart: true, class: 'index_form' ) %>
    <div class="fila"></div>
    <div class="linea">
      <%= fecha 'Fecha', 'note', 'date' %>
      <div class="elemento_x01">&nbsp;</div>
      <%= selector 'Cliente', 'note', 'client_id', @clients.map{|c| [c.name,c.id]}, enriquecido: true %>
    </div>
    <div class="elemento_derecha" id='boton_filtrado'><br/>
      <%= submit_tag 'Nueva venta', class: 'boton', 'data-disable-with' => 'Filtrando...' %>
    </div>
  </form>
  <br/>
</fieldset>