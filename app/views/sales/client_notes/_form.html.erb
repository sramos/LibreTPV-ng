<%= render partial: 'new_note_form' %>
<div id="client_note_#{@note.id}" class="linea">
  <div class='lateral'>
    <div class='caja_lateral'><%= render partial: 'total_cost' %></div>
    <% unless @note.closed %>
      <div class='caja_lateral'>
        <%#= render partial: 'note_lines/form_product' %>
        <%#= render partial: 'note_lines/form_concept' %>
      </div>
    <% end %>
  </div>
  <div class='contenido'>
    <%= render partial: 'sales/note_lines/index', locals: {allow_modify: true, fieldset_class: 'sublistado_entradas'} %>
  <div>
</div>