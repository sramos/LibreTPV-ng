<div id="client_note_<%= note.id %>" class="listadofila<%= ' flash-highlight' if local_assigns[:highlight] %>">
  <%= index_line note, 'client_notes' %>
  <div class="listado_derecha">
    <%= object_action icon: icon('cart-shopping', title: 'Productos'),
                        turbo_frame: "client_note_#{note.id}_sub",
                        url: sales_note_note_lines_path(note.id) %>
    <%= object_edition url: edit_sales_note_path(note.id), title: 'Editar venta' %>
    <%= object_destroy url: sales_note_path(note.id),
                       title: 'Eliminar venta',
                       confirmation: '¿Está seguro de querer eliminar la venta?' %>
  </div>
  <%= turbo_frame_tag "client_note_#{note.id}_sub" %>
</div>
