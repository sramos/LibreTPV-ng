<% header ||= 'Formulario' unless defined?(header) %>
<% dom_type_id = 'product_type_id' %>
<% dom_subtype_container = 'product_subtype_container' %>
<%= form_beginning model: [:products, @product], header: header %>
  <%= form_errors @product %>

  <div class="linea">
    <%= _text_field 'Código', 'product', 'code', '3_2' %>
  </div>
  <div class="linea">
    <%= _select_field 'Tipo', 'product', 'product_type_id', @product_types, '3_2', id: dom_type_id %>
    <div id="<%= dom_subtype_container %>">
      <%= render partial: 'products/products/form_product_subtype' %>
    </div>
  </div>
  <div class="linea">
    <%= _text_field 'Nombre', 'product', 'name', '3' %>
  </div>
  <div class="linea">
    <%= _text_field "Cantidad", 'product', 'stock' %>
    <%= _checkbox_field 'Activo', 'product', 'active', '2', {checked: @product.active} %>
  </div>
<%= form_end %>

<%= render partial: 'products/products/form_js',
           locals: {dom_type_id: dom_type_id,
                    dom_subtype_container: dom_subtype_container} %>