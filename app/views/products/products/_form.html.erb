<% header ||= 'Formulario' unless defined?(header) %>
<% dom_type_id = 'product_type_id' %>
<% dom_subtype_container = 'product_subtype_container' %>
<%= form_beginning model: [:products, @product], header: header %>
  <%= form_errors @product %>

  <div id="product_form_container">
    <%= render partial: 'products/products/form_content', locals: { product: @product } %>
  </div>
<%= form_end %>

<%= render partial: 'products/products/form_js',
           locals: {dom_type_id: dom_type_id,
                    dom_subtype_container: dom_subtype_container} %>