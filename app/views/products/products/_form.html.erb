<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:products, @product], header: header %>
  <%= form_errors @product %>
  <%= texto 'Nombre', 'product', 'name' %>
  <%= _checkbox 'Activo', 'product', 'active', {elemento: 'elemento_x05', izquierda: true, abajo: true, checked: @product.active} %>
<%= form_end %>