<div id="product_properties">
  <div class="linea">
    <%= _text_field 'Nombre', 'product', 'name', '3' %>
  </div>
  <div class="linea">
    <%= _select_field 'Editorial', 'product', 'publisher_id', @publishers, '2', include_blank: true %>
    <%= _text_field 'Edición', 'product', 'edition', '1' %>
  </div>
  <div class="linea">
    <%= _text_field 'Precio venta (PVP)', 'product', 'price', '1' %>
  </div>
</div>
