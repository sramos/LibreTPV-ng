<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:products, @supplier], header: header %>
  <%= form_errors @supplier %>
  <%= texto 'Nombre', 'supplier', 'name' %>
  <%= _checkbox 'Activo', 'supplier', 'active', {elemento: 'elemento_x05', izquierda: true, abajo: true, checked: @supplier.active} %>
<%= form_end %>