<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:products, @supplier], header: header %>
  <%= form_errors @supplier %>
  <div class="linea">
    <%= _text_field 'Nombre', 'supplier', 'name', '4', required: true %>
    <%= _text_field 'CIF', 'supplier', 'code_id', '1', required: true %>
    <div class="elemento_derecha">
      <%= _checkbox_field 'Activo', 'supplier', 'active', '1', {checked: @supplier.active} %>
    </div>
  </div>
  <div class="linea">
    <%= _text_field '% Descuento', 'supplier', 'discount_value', '1' %>
  </div>
  <%= render partial: 'products/suppliers/form_contact_info' %>
<%= form_end %>