<% contact_info = @supplier.contact_info || @supplier.build_contact_info %>
<div id="contact_info">
  <%= hidden_field_tag 'supplier[contact_info_attributes][id]', contact_info.id if contact_info&.id %>
  <div class="linea"><br></div>
  <div class="linea">
    <%= _text_field 'Dirección', 'supplier[contact_info_attributes]', 'address', '4', value: contact_info.address %>
    <%= _text_field 'Código Postal', 'supplier[contact_info_attributes]', 'postal_code', '1', value: contact_info.postal_code %>
  </div>
  <div class="linea">
    <%= _text_field 'Ciudad', 'supplier[contact_info_attributes]', 'city', '2', value: contact_info.city %>
    <%= _text_field 'Provincia', 'supplier[contact_info_attributes]', 'province', '2', value: contact_info.province %>
    <%= _text_field 'País', 'supplier[contact_info_attributes]', 'country', '1', value: contact_info.country %>
  </div>

  <div class="linea">
    <%= _text_field 'Persona de contacto', 'supplier[contact_info_attributes]', 'contact', '4', value: contact_info.contact %>
    <%= _text_field 'Teléfono', 'supplier[contact_info_attributes]', 'phone', '1', value: contact_info.phone %>
  </div>

  <div class="linea">
    <%= _text_field 'Email', 'supplier[contact_info_attributes]', 'email', '3', value: contact_info.email %>
    <%= _text_field 'Web', 'supplier[contact_info_attributes]', 'web', '3', value: contact_info.web %>
  </div>
</div>
