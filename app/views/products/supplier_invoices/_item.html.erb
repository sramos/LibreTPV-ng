<div id="invoice_<%= invoice.id %>" class="listadofila<%= ' flash-highlight' if local_assigns[:highlight] %>">
  <%= index_line invoice, 'supplier_invoices' %>
  <div class="listado_derecha">
    <%= icon('exclamation', title: 'La factura no está completamente pagada', class: 'color-red') if invoice.pending_payment > 0 %>
    <%= object_action icon: icon('euro-sign', title: 'Pagos'),
                      turbo_frame: "invoice_#{invoice.id}_sub",
                      url: products_supplier_invoice_payments_path(invoice.id) %>
    <%= object_action icon: icon('dolly', title: 'Productos'),
                      turbo_frame: "invoice_#{invoice.id}_sub",
                      url: note_lines_products_supplier_invoice_path(invoice.id) %>
    <%= object_action icon: icon('clipboard-list', title: 'Albaranes'),
                      turbo_frame: "invoice_#{invoice.id}_sub",
                      url: notes_products_supplier_invoice_path(invoice.id) %>
    <%= object_edition url: edit_products_supplier_invoice_path(invoice.id), title: 'Editar factura' %>
    <% confirmation_copy_text = "¿Estás seguro de querer generar un nuevo albarán a partir de esta factura?" %>
    <%= object_action icon: icon('copy', title: 'Copiar a nuevo albarán'),
                      confirmation: confirmation_copy_text,
                      disable_turbo_frame: true, method: :post,
                      url: copy_products_supplier_invoice_path(invoice.id) %>
    <%= object_destroy url: products_supplier_invoice_path(invoice.id),
                       title: 'Eliminar factura',
                       confirmation: '¿Está seguro de querer eliminar la factura?' %>
  </div>
  <%= turbo_frame_tag "invoice_#{invoice.id}_sub" %>
</div>
