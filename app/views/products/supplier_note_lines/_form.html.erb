<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:products, @note, @note_line], header: header %>
  <div class="fila">
    <div class="index_field linea"><b><%= 'Nombre/ISBN' %>:&nbsp;</b><%= @note_line.product_name %></div>
    <div class="index_field linea"><b><%= 'Precio venta' %>:&nbsp;</b><%= @note_line.product_price %></div>
  </div>
 <div class="linea"><br></div>
  <%= form_errors @note_line %>
  <div class="linea">
    <%= texto 'Cantidad', 'note_line', 'quantity' %>
    <%= texto '% Descuento', 'note_line', 'discount_value' %>
  </div>
<%= form_end %>