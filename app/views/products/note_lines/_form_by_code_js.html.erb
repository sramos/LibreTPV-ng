<script>
  (function() {
    var input = document.getElementById('formulario_campo_note_line_product_name');
    var codeInput = document.getElementById('formulario_campo_note_line_product_code');
    var form = document.querySelector('#product_by_code_div form');
    var productDataInput = form ? form.querySelector('input[name="product_data"]') : null;
    if (!input && !codeInput && !form) { return; }

    var suggestionsContainer = document.getElementById('product_name_suggestions');
    var timeoutId = null;      // para autocomplete por nombre
    var codeTimeoutId = null;  // para envío automático por código
    var floatingList = null; // capa flotante global

    function clearSuggestions() {
      if (floatingList && floatingList.parentNode) {
        floatingList.parentNode.removeChild(floatingList);
      }
      floatingList = null;
      if (suggestionsContainer) {
        suggestionsContainer.innerHTML = '';
      }
    }

    function buildSelect(products) {
      clearSuggestions();
      if (!products || products.length === 0) { return; }

      // Crear capa flotante fuera de product_by_code_div
      var rect = input.getBoundingClientRect();
      var listWrapper = document.createElement('div');
      listWrapper.className = 'product-name-suggestions-list';
      listWrapper.style.top = (rect.bottom + window.scrollY) + 'px';
      listWrapper.style.left = (rect.left - 40 + window.scrollX) + 'px';
      listWrapper.style.minWidth = rect.width + 'px';

      var ul = document.createElement('ul');

      products.forEach(function(p) {
        var li = document.createElement('li');
        li.textContent = p.name + ' (stock: ' + p.stock + ')';
        li.style.cursor = 'pointer';
        li.addEventListener('click', function() {
          input.value = p.name;
          clearSuggestions();

          var form = input.closest('form');
          if (form) {
            form.action = '<%= create_by_name_products_supplier_note_note_lines_path(@note) %>';
            if (form.requestSubmit) {
              form.requestSubmit();
            } else {
              form.submit();
            }
          }
        });
        ul.appendChild(li);
      });

      listWrapper.appendChild(ul);
      document.body.appendChild(listWrapper);
      floatingList = listWrapper;
    }

    function fetchSuggestions(query) {
      if (query.length < 4) { // sólo a partir de 4 caracteres
        clearSuggestions();
        return;
      }

      var url = '/products/products/search_by_name?q=' + encodeURIComponent(query);

      fetch(url, {
        headers: { 'Accept': 'application/json' }
      })
        .then(function(response) { return response.json(); })
        .then(function(data) { buildSelect(data); })
        .catch(function() { clearSuggestions(); });
    }

    if (input) {
      input.addEventListener('input', function() {
        var value = this.value || '';
        if (timeoutId) { clearTimeout(timeoutId); }
        timeoutId = setTimeout(function() {
          fetchSuggestions(value.trim());
        }, 300);
      });
    }

    // --- Envío automático por Código/ISBN ---

    function ensureProductDataInput(payload) {
      if (!form) { return; }

      if (payload) {
        if (!productDataInput || !form.contains(productDataInput)) {
          productDataInput = document.createElement('input');
          productDataInput.type = 'hidden';
          productDataInput.name = 'product_data';
          form.appendChild(productDataInput);
        }
        productDataInput.value = payload;
      } else if (productDataInput && form.contains(productDataInput)) {
        form.removeChild(productDataInput);
        productDataInput = null;
      }
    }

    function submitFormToCreateByCode(payload) {
      if (!form) { return; }

      ensureProductDataInput(payload);

      form.action = '<%= create_by_code_products_supplier_note_note_lines_path(@note) %>';
      if (form.requestSubmit) {
        form.requestSubmit();
      } else {
        form.submit();
      }
    }

    if (codeInput) {
      codeInput.addEventListener('input', function() {
        var value = this.value || '';
        if (codeTimeoutId) { clearTimeout(codeTimeoutId); }
        codeTimeoutId = setTimeout(function() {
          if (value.trim().length >= 5) {
            submitFormToCreateByCode();
          }
        }, 1000); // 1 segundo
      });
    }

    document.addEventListener('click', function(event) {
      var button = event.target.closest('.include-payload-button');
      if (!button) { return; }
      var payload = button.dataset.productData;
      if (!payload) { return; }

      submitFormToCreateByCode(payload);
    });
  })();
</script>


