  <div id="<%= params[:update] %>_line_<%= line.id %>" class="fila" >
    <%= fila_sublistado line %>
    <div class="listado_derecha" id="botones_<%= line.id %>">
      <% if allow_modify && !@note.closed %>
        <%#= link_to icono('Star', {title: 'Aplicar Acumulado'}), controller: 'note_lines', action: 'usar_acumulado', update: params[:update], id: line.id, note_id: line.note_id if line.note.client && line.product && linea.note.client.credit > 0 && line.discount_line.nil? %>
        <%= modal( icono('Write', {title: 'Editar'}), edit_client_note_note_line_path(line.note_id, line.id), "Editar línea") if line.product %>
        <% confirmation_text = "¿Estás seguro de eliminar de la cesta el artículo '#{line.product_name}'?" %>
        <%= link_to icono('Trash',{title: 'Borrar'}), client_note_note_line_path(line.note_id, line.id), data: { turbo_method: :delete, turbo_confirm: confirmation_text }, update: params[:update] %>
      <% end %>
    </div>
  </div>
  <div class="<%= params[:update] %>_editar_linea_<%= line.id %>" class="fila"></div>
