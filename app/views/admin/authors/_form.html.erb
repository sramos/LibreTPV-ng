<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @author], header: header %>
  <%= form_errors @author %>
  <%= texto 'Nombre', 'author', 'name' %>
  <%= _checkbox 'Activo', 'author', 'active', {elemento: 'elemento_x05', izquierda: true, abajo: true, checked: @author.active} %>
<%= form_end %>