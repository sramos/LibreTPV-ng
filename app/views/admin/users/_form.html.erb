<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @user], header: header %>
  <%= form_errors @user %>
  <%= texto 'Nombre', 'user', 'name' %>
  <%= texto 'Email', 'user', 'email' %>
  <%= _checkbox 'Activo', 'user', 'active', {elemento: 'elemento_x05', izquierda: true, abajo: true, checked: @user.active} %>
<%= form_end %>