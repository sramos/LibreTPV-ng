<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @user], header: header %>
  <%= form_errors @user %>
  <%= _text_field 'Nombre', 'user', 'name', '3' %>
  <%= _text_field 'Email', 'user', 'email', '2' %>
  <%= _checkbox_field 'Activo', 'user', 'active', '1', {checked: @user.active} %>
<%= form_end %>