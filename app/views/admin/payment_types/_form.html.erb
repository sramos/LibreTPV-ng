<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @payment_type], header: header %>
  <%= form_errors @payment_type %>
  <%= texto 'Nombre', 'payment_type', 'name' %>
  <%= _checkbox 'Caja', 'payment_type', 'cash', {clase: 'elemento_x05', izquierda: true, abajo: true, checked: @payment_type.cash} %>
  <%= _checkbox 'Activo', 'payment_type', 'active', {clase: 'elemento_x05', izquierda: true, abajo: true, checked: @payment_type.active} %>
<%= form_end %>