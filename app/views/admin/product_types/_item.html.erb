<div id="product_type_<%= product_type.id %>" class="listadofila<%= ' flash-highlight' if local_assigns[:highlight] %>">
  <%= index_line product_type, 'product_types' %>
  <div class="listado_derecha">
    <%= object_action icon: icon('list', title: 'Subtipos/Materias'),
                          turbo_frame: "product_subtype_sub_#{product_type.id}",
                          url: admin_product_type_product_subtypes_path(product_type.id) %>
    <%= object_edition url: edit_admin_product_type_path(product_type.id), title: "Editar tipo de producto '#{product_type.name}'" %>
    <%= object_destroy url: admin_product_type_path(product_type.id),
                       title: "Eliminar tipo de producto '#{product_type.name}'",
                       confirmation: "¿Está seguro de querer eliminar el tipo de producto '#{product_type.name}'?" %>
  </div>
  <%= turbo_frame_tag "product_subtype_sub_#{product_type.id}" do %>
    <div class="linea">
      <div class="listado_derecha">
        <%#= link_to icon('xmark', title: 'Cerrar'), '#',
                    onclick: "document.getElementById('product_subtype_sub_#{product_type.id}').innerHTML=''; return false;",
                    class: 'link-delete' %>
      </div>
    </div>
    <div class="product_subtype-container"></div>
  <% end %>
</div>
