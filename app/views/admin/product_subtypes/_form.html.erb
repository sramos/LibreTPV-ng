<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @product_type, @product_subtype], header: header %>
  <%= form_errors @product_subtype %>
  <div class="linea">
    <%= _text_field 'Nombre', 'product_subtype', 'name', '5_2' %>
    <%= _checkbox_field 'Activo', 'product_subtype', 'active', '1', {right: true, checked: @product_subtype.active} %>
  </div>
  <div class="linea">
    <%= _text_area_field 'Descripción', 'product_subtype', 'description' %>
  </div>
<%= form_end %>