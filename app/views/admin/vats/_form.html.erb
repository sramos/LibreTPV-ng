<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @vat], header: header %>
  <%= form_errors @vat %>
  <div class="linea">
    <%= _text_field 'Nombre', 'vat', 'name', '5_2', required: true %>
    <%= _text_field 'Valor (%)', 'vat', 'rate_value', '1', required: true %>
    <div class="elemento_derecha">
      <%= _checkbox_field 'Activo', 'vat', 'active', '1', {checked: @vat.active} %>
    </div>
  </div>
<%= form_end %>