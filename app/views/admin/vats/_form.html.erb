<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @vat], header: header %>
  <%= form_errors @vat %>
  <%= texto 'Nombre', 'vat', 'name' %>
  <%= texto 'Valor', 'vat', 'rate_value' %>
  <%= _checkbox 'Activo', 'vat', 'active', {elemento: 'elemento_x05', izquierda: true, abajo: true, checked: @vat.active} %>
<%= form_end %>