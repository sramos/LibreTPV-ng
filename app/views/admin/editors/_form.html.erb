<% header ||= 'Formulario' unless defined?(header) %>
<%= form_beginning model: [:admin, @editor], header: header %>
  <%= form_errors @editor %>
  <%= texto 'Nombre', 'editor', 'name' %>
  <%= _checkbox 'Activo', 'editor', 'active', {elemento: 'elemento_x05', izquierda: true, abajo: true, checked: @editor.active} %>
<%= form_end %>