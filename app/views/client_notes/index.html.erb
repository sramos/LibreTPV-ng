<fieldset id='filtros' class='filtrado'>
  <%= render partial: 'form' %>
</fieldset>

<% if @notes.size > 0 %>
  <!--- Listado de albaranes --->
  <div class='caja_completa'>
    <%= cabecera_listado 'client_notes' %>
    <% i = 0 %>
    <% for objeto in @notes%>
      <div id="albaran_<%= i +=1 %>" class="listadofila">
        <%= fila_listado objeto %>
        <div class="listado_derecha">
          <%#= link_to_remote icono('Cart', title: 'Ver Productos'), url: { controller: :client_note_lines, action: :index, note_id: objeto.id, update: "albaran_sub_" + i.to_s }, :loading => "Element.show('spinner_#{i.to_s }')", :complete => "Element.hide('spinner_#{i.to_s}')" %>
          <%= link_to icono('Write', title: 'Editar'), action: :edit, id: objeto %>
          <%= borrrado icono('Trash', title: 'Borrar'), { action: 'delete', id: objeto.id } , 'Eliminar compra', "Compra pendiente de " + objeto.client.name, :ajax => false %>
        </div>
      </div>
      <div id="spinner_<%= i.to_s %>" class="spinner" style="display:none" ></div>
      <div id="albaran_sub_<%= i.to_s %>">
      </div>
    <% end %>
    <%= final_listado %>
  </div>
<% end %>
