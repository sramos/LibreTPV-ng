<fieldset id='filtros' class='filtrado'>
  <%= render partial: 'form' %>
</fieldset>

<div id='lineas_albaran' class='linea'>
  <div class='lateral'>
    <div class='caja_lateral'><%= render partial: 'importe_total' %></div>
    <% unless @note.closed %>
      <div class='caja_lateral'>
        <%= render partial: 'note_lines/form_product' %>
        <%= render partial: 'note_lines/form_concept' %>
      </div>
    <% end %>
  </div>
  <div class='contenido'>
    <%= render partial: 'note_lines/lines', locals: {edicion: true} %>
  <div>
</div>
