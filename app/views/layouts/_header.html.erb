
<div id="cabecera">
  <div id="avisos" style="display:none;">Esto es un aviso</div>
  <% all_sections = menu_secciones(current_user) %>
  <% section_menu = menu_controladores %>

  <!-- BARRA SUPERIOR DE SECCIONES -->
  <div id="barrasuperior">
    <div id="secciones">
      <% if params[:section] %>
        <ul id="listado-secciones">
          <% all_sections.each_pair do |s_key, section| %>
            <li>
              <a id="section_<%= s_key %>" title="<%= section[:title] %>" href="<%= section[:url] %>">
                <div class="<%= params[:section] == s_key ? 'seleccionado' : ''%>">
                  <%= section[:title] %>
                </div>
              </a>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div id="estado">
      <p>
        <% if params[:section] %>
          <%= params[:section].to_s.capitalize + " - " + controlador_rotulo(params[:controller]) %>
        <% end %>
      </p>
    </div>

    <div id="opciones-usuario">
      <div id="logo"></div>
      <% if user_signed_in? %>
        <div id="signed_user">
          <%= current_user.name %> | <%= link_to "Salir", destroy_user_session_path, method: :delete, data: {turbo_method: :delete } %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- BARRA SUPERIOR DE ACCIONES -->
  <% unless section_menu.empty? %>
    <div id="menucontroladores">
      <div id="centromenucontroladores">
        <% section_menu.each do |option| %>
          <div id="controlador_<%= option[:controlador] %>" class="<%= (option[:controlador] == params[:controller]) ? "destacado"  : "fondo" %>">
            <%= link_to option[:label], controller: option[:controlador], action: :index %>
          </div>
          <% unless section_menu.last == option %>
            <div class='separador'></div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>