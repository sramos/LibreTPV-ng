<!-- CONTENIDO DE LAS ACCIONES -->
<div id="centro" class="centro <%= 'unsigned-user' unless user_signed_in? %>">
  <!-- Mensajes de informacion -->
  <%= ok_message flash[:ok_message] if flash[:ok_message] %>
  <% if flash[:ok_message_fade] %>
    <div id="flash_ok_wrapper" class="flash-fade">
      <%= ok_message flash[:ok_message_fade] %>
    </div>
    <script>
      (function(){
        var el = document.getElementById('flash_ok_wrapper');
        if (!el) return;
        setTimeout(function(){
          el.classList.add('hide');
        }, 2500);
        setTimeout(function(){
          if (el && el.parentNode) { el.parentNode.removeChild(el); }
        }, 3200);
      })();
    </script>
  <% end %>
  <%= mensaje_error(flash[:error]) if flash[:error]%>
  <%= render partial: 'common/index_filter' if @filter_fields %>
  <!-- Contenido de cada accion -->
  <%= yield %>
  <br/><br/>
</div>

